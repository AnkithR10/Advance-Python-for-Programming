#While+Break
while True:
    print("--------------------\n1.Add\n2.Subtraction\n3.Exit")
    choice=input("Enter choice: ")

    match choice:
        case "1":
            a=int(input("Enter the first number:"))
            b=int(input("Enter the second number:"))
            print("Result=",a+b)
        case"2":
             a=int(input("Enter the first number:"))
             b=int(input("Enter the second number:"))
             print("Result=",a-b)
        case "#"|"0":
            print("Program terminated")
            break
        case _:
            print("Invalid choice")
            break
        